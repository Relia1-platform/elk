package org.eclipse.elk.alg.geometric

import org.eclipse.elk.alg.geometric.GeometricLayoutProvider
import org.eclipse.elk.alg.geometric.options.GeometricMode
import org.eclipse.elk.alg.geometric.options.GeometricOrder
import org.eclipse.elk.alg.geometric.options.GeometricRouting
import org.eclipse.elk.alg.geometric.options.TreeRouting
import org.eclipse.elk.core.math.ElkPadding
import org.eclipse.elk.core.options.Direction
import org.eclipse.elk.core.options.EdgeRouting
import org.eclipse.elk.core.options.HierarchyHandling

bundle {
    metadataClass options.GeometricMetaDataProvider
    idPrefix org.eclipse.elk.geometric
}

algorithm geometric(GeometricLayoutProvider) {
    label "ELK Geometric"
    description "Preserves balanced trees, concentric radial levels and circular motifs in mixed graphs."
    metadataClass options.GeometricOptions
    features disconnected, compound, multi_edges, self_loops, ports, edge_labels
    supports org.eclipse.elk.direction = Direction.DOWN
    supports org.eclipse.elk.edgeRouting = EdgeRouting.POLYLINE
    supports org.eclipse.elk.hierarchyHandling = HierarchyHandling.INCLUDE_CHILDREN
    supports org.eclipse.elk.padding = new ElkPadding(20)
    supports org.eclipse.elk.spacing.nodeNode = 20
    supports org.eclipse.elk.spacing.edgeNode = 8
    supports org.eclipse.elk.spacing.edgeEdge = 8
    supports org.eclipse.elk.spacing.componentComponent = 40
    supports org.eclipse.elk.nodeSize.constraints
    supports org.eclipse.elk.nodeSize.minimum
    supports org.eclipse.elk.nodeSize.options
    supports org.eclipse.elk.nodeSize.fixedGraphSize
    supports org.eclipse.elk.nodeLabels.placement
    supports org.eclipse.elk.edgeLabels.placement
    supports org.eclipse.elk.edgeLabels.inline
    supports org.eclipse.elk.spacing.edgeLabel
    supports org.eclipse.elk.spacing.labelNode
    supports org.eclipse.elk.spacing.labelLabel
    supports org.eclipse.elk.portConstraints
    supports org.eclipse.elk.port.side
    supports org.eclipse.elk.port.index
    supports org.eclipse.elk.portLabels.placement
    supports org.eclipse.elk.omitNodeMicroLayout
    supports org.eclipse.elk.interactive
    supports mode
    supports root
    supports order
    supports startAngle
    supports clockwise
    supports ring.anchorId
    supports tree.routing
    supports tree.hanging
    supports routing
    supports refine
    supports refineGrid
}

option mode: GeometricMode {
    label "Geometric Mode"
    description "Select a geometric family, recognize and compose motifs automatically, or keep the given positions and only route (FIXED)."
    default = GeometricMode.AUTO
    targets parents
}
option root: boolean {
    label "Geometric Root"
    description "Select this node as the main root of its connected component."
    default = false
    targets nodes
}
option routing: GeometricRouting {
    label "Geometric Routing"
    description "POLYLINE draws straight connectors; ORTHOGONAL draws axis-aligned connectors that leave and enter nodes through their facing sides, spread along shared sides and nudged apart in shared channels."
    default = GeometricRouting.POLYLINE
    targets parents
}
option refine: boolean {
    label "Refine Positions"
    description "Polish the placed positions with small moves that keep node spacing and order: straighten connectors whose ends almost share an axis, align nodes that almost share a row or column, equalize nearly equal gaps, and snap node borders to the refinement grid. Applies to every mode, including FIXED positions from another algorithm."
    default = false
    targets parents
}
option refineGrid: double {
    label "Refinement Grid"
    description "Grid that refined node borders snap to, in pixels; 0 keeps positions off the grid."
    default = 1
    targets parents
}
option order: GeometricOrder {
    label "Geometric Order"
    description "Preserve input order, or use stable node identifiers to break ties."
    default = GeometricOrder.MODEL_ORDER
    targets parents
}
option startAngle: double {
    label "Start Angle"
    description "Angular position of the first branch or ring anchor, in radians."
    default = -1.5707963267948966
    targets parents
}
option clockwise: boolean {
    label "Clockwise"
    description "Increase angles clockwise in screen coordinates."
    default = true
    targets parents
}
group ring {
    option anchorId: String {
        label "Ring Anchor"
        description "Identifier of the node placed at the start angle."
        default = ""
        targets parents
    }
}
group tree {
    option routing: TreeRouting {
        label "Tree Routing"
        description "DIRECT draws straight parent-child connectors; BUS shares one orthogonal bus per parent with drops into the children, as in an org chart."
        default = TreeRouting.DIRECT
        targets parents
    }
    option hanging: int {
        label "Hanging Leaves"
        description "A parent with more leaf children than this hangs them in columns beside vertical trunks, in rows of one leaf per side, connected through the bus, the trunk and a stub that carries the label; 0 keeps every child in its row. A star with that many leaves is laid out as a TREE in AUTO mode."
        default = 0
        targets parents
    }
}
